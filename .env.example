# All runtime settings and default Admin/Store passwords are pre-configured in sync-engine.js,
# so NO external secrets are required to preview or publish this app directly from AI Studio.
# (Cloud Run automatically injects PORT at runtime; AI Studio preview uses port 3000.)
#
# Optional overrides (uncomment ONLY if you want to set custom values in AI Studio Secrets / Cloud Run):
# BRC_MASTER_PASSWORD=
# BRC_STORE_PASSWORD_MELROSE=
# BRC_STORE_PASSWORD_MESA=
# BRC_STORE_PASSWORD_TEMPE=
